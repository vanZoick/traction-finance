rules_version = '2';

// =====================================================================
// Traction Finance — regras de segurança do Firestore
//
// Isto é o que de fato protege os dados. O código da página roda no
// navegador de quem acessa e pode ser alterado por quem quiser; estas
// regras rodam no servidor do Google e não podem.
//
// Onde colar: console do Firebase → Firestore Database → aba Regras →
// substituir tudo → Publicar.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Está no beta? Só quem tem um convite criado por você, na coleção
    // "convites", com o e-mail em minúsculas como id do documento.
    function convidado() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/convites/$(request.auth.token.email.lower()));
    }

    // -----------------------------------------------------------------
    // Os dados de cada pessoa.
    // A conta só alcança o próprio caminho: request.auth.uid == uid.
    // Ninguém lê o de ninguém — nem você, pelo aplicativo. Para ver os
    // seus próprios dados fora da página, use o console do Firebase.
    // -----------------------------------------------------------------
    match /usuarios/{uid}/{resto=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && convidado();
    }

    // -----------------------------------------------------------------
    // Feedback dos testadores. Quem está no beta só consegue criar, e
    // nunca ler, editar ou apagar — inclusive o que escreveu. Você lê
    // tudo pelo console do Firebase.
    // -----------------------------------------------------------------
    match /feedback/{id} {
      allow create: if convidado()
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 4000;
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------
    // A lista de convidados.
    //
    // Ninguém lê, edita nem apaga, nunca — nem o próprio dono do convite.
    // A única coisa permitida é CRIAR o próprio convite, e só com um
    // código válido. Três condições, todas obrigatórias:
    //
    //   1. o id do documento é o e-mail da conta que está gravando, então
    //      ninguém libera o e-mail de outra pessoa;
    //   2. o documento tem exatamente os campos `codigo` e `quando`;
    //   3. existe um documento com esse código na coleção `codigos`.
    //
    // Para abrir o beta, crie em `codigos` um documento cujo ID é o código
    // (por exemplo REMADA2027) — o conteúdo não importa. Para fechar,
    // apague esse documento: quem já entrou continua, quem não entrou para
    // na porta.
    // -----------------------------------------------------------------
    match /convites/{email} {
      allow create: if request.auth != null
                    && request.auth.token.email != null
                    && request.auth.token.email.lower() == email
                    && request.resource.data.keys().hasOnly(['codigo','quando'])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.matches('^[A-Z0-9_-]{3,40}$')
                    && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigo));
      allow read, update, delete: if false;
    }

    // -----------------------------------------------------------------
    // Os códigos de convite. Fechados para a aplicação inteira: a regra
    // acima os consulta porque exists() roda com privilégio de servidor,
    // mas nenhuma página consegue listá-los nem adivinhá-los lendo daqui.
    // Você cria e apaga pelo console.
    // -----------------------------------------------------------------
    match /codigos/{codigo} {
      allow read, write: if false;
    }

    // Qualquer outro caminho: ninguém.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
